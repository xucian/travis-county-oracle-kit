 "free_text_license_markers": {
  "rows_in_export": 2380707,
  "queries": [
   {
    "label": "description contains TACLA (TDLR A/C contractor license prefix)",
    "where": "upper(description) like '%TACLA%'",
    "rows": 1
   },
   {
    "label": "description contains TECL (TDLR electrical contractor license prefix)",
    "where": "upper(description) like '%TECL%'",
    "rows": 9
   },
   {
    "label": "description contains LICENSE #, LIC # or LIC#",
    "where": "upper(description) like '%LICENSE #%' OR upper(description) like '%LIC #%' OR upper(description) like '%LIC#%'",
    "rows": 4
   },
   {
    "label": "contractor company or full name contains TACLA or TECL",
    "where": "upper(contractor_company_name) like '%TACLA%' OR upper(contractor_company_name) like '%TECL%' OR upper(contractor_full_name) like '%TACLA%' OR upper(contractor_full_name) like '%TECL%'",
    "rows": 0
